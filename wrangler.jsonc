{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xerogamebot",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "alias": {
    "@": "./src"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "GameDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameDurableObject"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_PROVIDER": "auto"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
